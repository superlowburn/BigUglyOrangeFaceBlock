{
  "manifest_version": 3,
  "name": "Goggles",
  "description": "Frost images and videos until you choose to reveal them.",
  "version": "0.1.0",
  "icons": {
    "16": "dist/icons/icon16.png",
    "32": "dist/icons/icon32.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "declarativeNetRequestWithHostAccess", "webNavigation"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://player.vimeo.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "provider_pre_request_gate",
      "enabled": true,
      "path": "public/provider-rules.json"
    }]
  },
  "web_accessible_resources": [{
    "resources": ["provider-blocked.html"],
    "matches": ["<all_urls>"]
  }],
  "background": { "service_worker": "dist/service-worker.js" },
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_icon": {
      "16": "dist/icons/icon16.png",
      "32": "dist/icons/icon32.png"
    }
  },
  "options_ui": { "page": "dist/options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/shadow-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
